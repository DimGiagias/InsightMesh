# Provider: openai | gemini | openrouter | ollama
LLM_PROVIDER=
# Optional: model for the provider above (defaults: gpt-4o, gemini-3.1-flash-lite, google/gemma-4-31b-it:free, llama3.1)
LLM_MODEL=
LLM_TEMPERATURE=0

# Optional: pin a model per provider, takes precedence over LLM_MODEL
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key # GOOGLE_API_KEY is also accepted in place of GEMINI_API_KEY
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://localhost:11434

LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT="InsightMesh"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
